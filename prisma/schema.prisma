generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  idle
  running
  waiting_approval
  blocked
  failed
  offline
}

enum HealthStatus {
  ok
  degraded
  failing
  unknown
}

enum ProjectStatus {
  active
  blocked
  submitted
  completed
  archived
}

enum TaskStatus {
  queued
  running
  waiting_children
  aggregation_pending
  awaiting_verifier
  waiting_approval
  needs_changes
  completed
  failed
}

enum ApprovalStatus {
  pending
  approved_waiting_execution
  executing
  rejected
  needs_changes
  completed
  manual_handoff
}

enum ApprovalType {
  bounty_submission
  revenue_outreach
  wallet_kyc
  live_trading
  paid_action
  deploy
  public_disclosure
  other
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum ArtifactType {
  report
  poc
  csv
  decision_log
  discord_thread
  github_commit
  cron_output
  screenshot
  config_backup
  status_file
  other
}

enum PolicyAction {
  allow
  require_approval
  block
  require_manual_handoff
}

enum EventSeverity {
  info
  warning
  critical
}

enum CommandStatus {
  queued
  waiting_approval
  blocked
  waiting_manual_handoff
  running
  completed
  failed
  cancelled
}

enum RuntimeState {
  idle
  starting
  running
  paused
  stopping
  stopped
  blocked
  failed
  offline
  unknown
}

enum HeartbeatSource {
  worker
  cli
  api
  cron
  browser
  external
}

enum OrchestrationRunStatus {
  queued
  planning
  running
  waiting_children
  waiting_approval
  aggregating
  verifying
  completed
  failed
  cancelled
}

enum ControlActionStatus {
  requested
  queued
  approval_required
  approved
  running
  completed
  failed
  cancelled
  rejected
  manual_handoff
  blocked
}

enum TraceSpanKind {
  orchestration
  task
  command
  approval
  model
  tool
  worker
  api
  event
  verifier
}

enum TraceSpanStatus {
  pending
  running
  ok
  error
  cancelled
  blocked
}

enum RunStepStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}

enum CandidateStatus {
  new
  enriching
  ready_for_review
  converted
  rejected
  deferred
}

enum CandidateVisibility {
  private
  internal
  external
  public
}

enum AutonomyDecision {
  allow
  allow_with_verification
  require_owner_approval
  require_manual_handoff
  block
  pause
  lower_autonomy
}

enum AutonomyRunStatus {
  queued
  running
  waiting_children
  waiting_approval
  verifying
  completed
  failed
  cancelled
  blocked
}

enum ProjectDraftStatus {
  drafting
  needs_enrichment
  needs_owner_decision
  approved
  rejected
  deferred
  activated
}

enum OwnerDecisionRequestStatus {
  open
  approved
  rejected
  needs_changes
  deferred
  manual_handoff
  withdrawn
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  role      String    @default("operator")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  events    Event[]   @relation("EventActor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  status      AgentStatus  @default(idle)
  health      HealthStatus @default(unknown)
  heartbeatAt DateTime?
  currentTask String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks        Task[]
  artifacts    Artifact[]
  events       Event[]
  capabilities AgentCapability[]
}

model AgentCapability {
  id                      String       @id @default(cuid())
  agentId                 String
  capabilityKey           String
  inputSchema             Json         @default("{}")
  outputSchema            Json         @default("{}")
  allowedTools            Json         @default("[]")
  maxRisk                 RiskLevel    @default(low)
  expectedArtifactType    ArtifactType @default(report)
  successCriteria         Json         @default("[]")
  failureModes            Json         @default("[]")
  rollbackOrManualHandoff String
  requiresApproval        Boolean      @default(false)
  avgCost                 Float        @default(0)
  avgDuration             Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  agent                   Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capabilityKey])
  @@index([capabilityKey])
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  status      ProjectStatus @default(active)
  revenueType String?
  nextAction  String?
  blocker     String?
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       Task[]
  approvals   Approval[]
  artifacts   Artifact[]
  events      Event[]
}

model Task {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  status      TaskStatus @default(queued)
  riskLevel   RiskLevel  @default(low)
  summary     String?
  blocker     String?
  nextAction  String?
  agentId     String?
  projectId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  agent       Agent?     @relation(fields: [agentId], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])
  approvals   Approval[]
  artifacts   Artifact[]
  events      Event[]
}

model Approval {
  id              String         @id @default(cuid())
  externalKey     String?        @unique
  type            ApprovalType
  status          ApprovalStatus @default(pending)
  riskLevel       RiskLevel      @default(low)
  title           String
  summary         String
  decisionNote    String?
  manualReportId  String?
  requestedBy     String?
  projectId       String?
  taskId          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project?       @relation(fields: [projectId], references: [id])
  task            Task?          @relation(fields: [taskId], references: [id])
  commandQueues   CommandQueue[]
  events          Event[]
}

model Artifact {
  id                String       @id @default(cuid())
  type              ArtifactType
  title             String
  path              String?
  url               String?
  repo              String?
  commitSha         String?
  contentHash       String       @unique
  restricted        Boolean      @default(false)
  restrictionReason String?
  agentId           String?
  projectId         String?
  taskId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  agent             Agent?       @relation(fields: [agentId], references: [id])
  project           Project?     @relation(fields: [projectId], references: [id])
  task              Task?        @relation(fields: [taskId], references: [id])
  events            Event[]
}

model CommandQueue {
  id           String        @id @default(cuid())
  actionType   String
  status       CommandStatus @default(queued)
  riskLevel    RiskLevel     @default(low)
  payload      Json          @default("{}")
  result       Json?
  approvalId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  approval     Approval?     @relation(fields: [approvalId], references: [id])
  events       Event[]
}

model Policy {
  id          String       @id @default(cuid())
  actionType  String       @unique
  action      PolicyAction
  riskLevel   RiskLevel    @default(low)
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Event {
  id             String         @id @default(cuid())
  type           String
  severity       EventSeverity  @default(info)
  message        String
  metadata       Json           @default("{}")
  actorId        String?
  agentId        String?
  projectId      String?
  taskId         String?
  approvalId     String?
  artifactId     String?
  commandQueueId String?
  createdAt      DateTime       @default(now())
  actor          User?          @relation("EventActor", fields: [actorId], references: [id])
  agent          Agent?         @relation(fields: [agentId], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id])
  task           Task?          @relation(fields: [taskId], references: [id])
  approval       Approval?      @relation(fields: [approvalId], references: [id])
  artifact       Artifact?      @relation(fields: [artifactId], references: [id])
  commandQueue   CommandQueue?  @relation(fields: [commandQueueId], references: [id])
}

model AgentRuntimeStatus {
  id            String       @id @default(cuid())
  agentId       String       @unique
  state         RuntimeState @default(unknown)
  host          String?
  processName   String?
  version       String?
  currentRunId  String?
  currentTaskId String?
  currentStepId String?
  heartbeatAt   DateTime?
  lastStartedAt DateTime?
  lastStoppedAt DateTime?
  lastError      String?
  metrics       Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([state])
  @@index([heartbeatAt])
}

model AgentHeartbeat {
  id         String          @id @default(cuid())
  agentId    String
  source     HeartbeatSource @default(worker)
  status     RuntimeState    @default(unknown)
  observedAt DateTime        @default(now())
  latencyMs  Int?
  queueDepth Int?
  runId      String?
  taskId     String?
  traceId    String?
  metadata   Json            @default("{}")

  @@index([agentId, observedAt])
  @@index([traceId])
}

model OrchestrationRun {
  id            String                 @id @default(cuid())
  traceId       String                 @unique
  status        OrchestrationRunStatus @default(queued)
  title         String
  summary       String?
  rootTaskId    String?
  projectId     String?
  ownerAgentId  String?
  parentRunId   String?
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  riskLevel     RiskLevel              @default(low)
  autonomyLevel String?
  decision      String?
  metadata      Json                   @default("{}")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, updatedAt])
  @@index([projectId, status])
  @@index([ownerAgentId, status])
}

model ControlAction {
  id             String              @id @default(cuid())
  actionType     String
  status         ControlActionStatus @default(requested)
  riskLevel      RiskLevel           @default(low)
  targetAgentId  String?
  runId          String?
  taskId         String?
  commandQueueId String?
  approvalId     String?
  requestedBy    String?
  reason         String?
  scopeLimit     String?
  payload        Json                @default("{}")
  result         Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([targetAgentId, status])
  @@index([runId, status])
  @@index([commandQueueId])
  @@index([approvalId])
}

model TraceSpan {
  id             String          @id @default(cuid())
  traceId        String
  runId          String?
  parentSpanId   String?
  taskId         String?
  commandQueueId String?
  eventId        String?
  kind           TraceSpanKind
  name           String
  status         TraceSpanStatus @default(pending)
  startedAt      DateTime?
  endedAt        DateTime?
  durationMs     Int?
  attributes     Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([traceId, startedAt])
  @@index([runId, startedAt])
  @@index([parentSpanId])
  @@index([taskId])
}

model RunStep {
  id          String        @id @default(cuid())
  runId       String
  taskId      String?
  agentId     String?
  spanId      String?
  sequence    Int
  name        String
  status      RunStepStatus @default(pending)
  input       Json          @default("{}")
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([runId, sequence])
  @@index([taskId, status])
  @@index([agentId, status])
}

model ModelCall {
  id           String          @id @default(cuid())
  spanId       String?
  runId        String?
  taskId       String?
  model        String
  status       TraceSpanStatus @default(ok)
  inputTokens  Int             @default(0)
  outputTokens Int             @default(0)
  costUsd      Float           @default(0)
  latencyMs    Int?
  errorClass   String?
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())

  @@index([runId, createdAt])
  @@index([taskId, createdAt])
  @@index([spanId])
}

model ToolCall {
  id         String          @id @default(cuid())
  spanId     String?
  runId      String?
  taskId     String?
  toolName   String
  status     TraceSpanStatus @default(ok)
  durationMs Int?
  exitCode   Int?
  errorClass String?
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now())

  @@index([runId, createdAt])
  @@index([taskId, createdAt])
  @@index([spanId])
}

model AutonomyPolicy {
  id                      String           @id @default(cuid())
  scopeKey                String           @unique
  maxAutonomyLevel        String           @default("L5")
  emergencyState          String           @default("normal")
  allowedActions          Json             @default("[]")
  approvalRequiredActions Json             @default("[]")
  blockedActions          Json             @default("[]")
  concurrencyLimit        Int              @default(1)
  budgetLimit             Json             @default("{}")
  riskRules               Json             @default("[]")
  ownerApprovalId         String?
  metadata                Json             @default("{}")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([emergencyState])
}

model AutonomyRun {
  id                      String            @id @default(cuid())
  runType                 String
  status                  AutonomyRunStatus @default(queued)
  trigger                 Json              @default("{}")
  policyId                String?
  decision                AutonomyDecision  @default(allow)
  primaryAgent            String
  childRunIds             Json              @default("[]")
  candidateIds            Json              @default("[]")
  projectDraftIds         Json              @default("[]")
  ownerDecisionRequestIds Json              @default("[]")
  startedAt               DateTime?
  completedAt             DateTime?
  eventIds                Json              @default("[]")
  traceId                 String            @unique
  artifactIds             Json              @default("[]")
  verificationIds         Json              @default("[]")
  metrics                 Json              @default("{}")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([status, updatedAt])
  @@index([runType, status])
  @@index([primaryAgent, status])
}

model OpportunityCandidate {
  id                 String              @id @default(cuid())
  title              String
  status             CandidateStatus     @default(new)
  source             Json                @default("{}")
  summary            String
  customerPain       String?
  proposedAngle      String?
  marketSignals      Json                @default("[]")
  competitorSignals  Json                @default("[]")
  confidence         String              @default("low")
  score              Json                @default("{}")
  riskLevel          RiskLevel           @default(medium)
  visibility         CandidateVisibility @default(internal)
  excludedReason     String?
  projectDraftId     String?
  eventIds           Json                @default("[]")
  traceId            String              @unique
  artifactIds        Json                @default("[]")
  verificationIds    Json                @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, updatedAt])
  @@index([riskLevel, status])
}

model ImprovementCandidate {
  id              String              @id @default(cuid())
  title           String
  status          CandidateStatus     @default(new)
  area            String
  detectedBy      String
  signalRefs      Json                @default("[]")
  problem         String
  impact          Json                @default("{}")
  proposedFix     String
  autonomyFit     String              @default("auto_prepare_only")
  riskLevel       RiskLevel           @default(medium)
  visibility      CandidateVisibility @default(internal)
  taskId          String?
  projectDraftId  String?
  eventIds        Json                @default("[]")
  traceId         String              @unique
  artifactIds     Json                @default("[]")
  verificationIds Json                @default("[]")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, updatedAt])
  @@index([area, status])
  @@index([riskLevel, status])
}

model ProjectDraft {
  id                       String             @id @default(cuid())
  title                    String
  sourceCandidateIds       Json               @default("[]")
  status                   ProjectDraftStatus @default(drafting)
  summary                  String
  problem                  String?
  proposedOutcome          String?
  scope                    Json               @default("{}")
  classification           Json               @default("{}")
  successCriteria          Json               @default("[]")
  milestones               Json               @default("[]")
  tasks                    Json               @default("[]")
  dependencies             Json               @default("[]")
  blockers                 Json               @default("[]")
  requiredOwnerDecisionIds Json               @default("[]")
  artifactIds              Json               @default("[]")
  eventIds                 Json               @default("[]")
  traceId                  String             @unique
  verificationIds          Json               @default("[]")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([status, updatedAt])
}

model OwnerDecisionRequest {
  id                 String                     @id @default(cuid())
  title              String
  requestedByAgent   String
  decisionType       String
  urgency            String                     @default("normal")
  riskLevel          RiskLevel                  @default(medium)
  ownerQuestion      String
  contextSummary     String
  recommendation     Json?
  options            Json                       @default("[]")
  impact             Json                       @default("{}")
  gates              Json                       @default("{}")
  evidenceRefs       Json                       @default("[]")
  allowedResponses   Json                       @default("[]")
  status             OwnerDecisionRequestStatus @default(open)
  approvalId         String?
  traceId            String                     @unique
  eventIds           Json                       @default("[]")
  artifactIds        Json                       @default("[]")
  verificationIds    Json                       @default("[]")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status, updatedAt])
  @@index([riskLevel, status])
  @@index([requestedByAgent, status])
}
